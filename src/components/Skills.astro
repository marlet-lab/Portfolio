---
const skills = [
    {
        name: "Javascript",
        icon: "/icons/javascript.svg"
    },
    {
        name: "Typescript",
        icon: "/icons/typescript.svg"
    },
    {
        name: "React",
        icon: "/icons/react.svg"
    },
    {
        name: "Figma",
        icon: "/icons/figma.svg"
    },
    {
        name: "Tailwind",
        icon: "/icons/tailwindcss.svg"
    },
    {
        name: "Java",
        icon: "/icons/java.svg"
    }, 
    {
        name: ".Net",
        icon: "/icons/net.svg"
    },
    {
        name: "SQL",
        icon: "/icons/sqldeveloper.svg"
    },
    {
        name: "VS Code",
        icon: "/icons/vscode.svg"
    },
    {
        name: "X Code",
        icon: "/icons/xcode.svg"

    },
    {
        name: "Firebase",
        icon: "/icons/True.svg"
    },
];
---

<section class="skills">

    <div class="container">

        <div class="skills-header">

            <!-- <span class="skills-label">
                Skills
            </span> -->

            <p class="skills-description">
                The skills, tools and technologies used in my projects:
            </p>

        </div>

    </div>


    <div class="skills-marquee">

        <div class="skills-track">

            {skills.map((skill) => (
                <div class="skill">

                    <img
                        src={skill.icon}
                        alt=""
                        class="skill-icon"
                    />

                    <span class="skill-name">
                        {skill.name}
                    </span>

                </div>
            ))}

            {skills.map((skill) => (
                <div class="skill" aria-hidden="true">

                    <img
                        src={skill.icon}
                        alt=""
                        class="skill-icon"
                    />

                    <span class="skill-name">
                        {skill.name}
                    </span>

                </div>
            ))}

        </div>

    </div>

</section>