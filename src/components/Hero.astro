<section class="hero">
    <div class="hero-content">

        <p class="hero-title" id="hero-title">
            <span class="typing-text"></span>
            <span class="typing-cursor">|</span>
        </p>

        <div class="hero-bottom">

            <div class="hero-time">
                <span class="status-dot"></span>
                <span>03:15:57</span>
                <span class="timezone">[ GMT +1 ]</span>
            </div>

            <div class="hero-socials">
                <a href="#" target="_blank">[ LINKEDIN ]</a>
                <a href="#" target="_blank">[ GITHUB ]</a>
            </div>

            <a class="hero-work">
                <span class="circle-arrow">↓</span>
                <span>SEE WORK</span>
            </a>

        </div>

    </div>
</section>

<script>
    const text = "Maria Leth - Software & Design Engineer.";
    const element = document.querySelector(".typing-text") as HTMLElement;
    const cursor = document.querySelector(".typing-cursor") as HTMLElement;


    let index = 0;

    function typeText() {
        if (index < text.length) {
            element.textContent += text.charAt(index);
            index++;

            setTimeout(typeText, 50);
        } else {
            cursor.classList.add("finished");
        }
    }
    typeText();
</script>