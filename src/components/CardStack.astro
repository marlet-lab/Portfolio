---
interface Card {
    question: string;
    answer: string;
}

interface Props {
    cards: Card[];
}

const { cards } = Astro.props;
---

<div class="card-stack" data-card-stack>

    {cards.map((card, index) => (
        <article
            class="stack-card"
            data-card={index}
        >
            <div class="card-content">

                <span class="card-number">
                    {String(index + 1).padStart(2, "0")}
                </span>

                <div class="card-text">

                    <h3>{card.question}</h3>

                    <div class="card-line"></div>

                    <p>{card.answer}</p>

                </div>

                <span class="card-hint">
                    DRAG TO EXPLORE →
                </span>

            </div>
        </article>
    ))}

</div>


<style>

    /* =========================
       CARD STACK
       ========================= */

    .card-stack {
        position: relative;

        width: min(100%, 520px);
        height: 430px;

        margin: 0 auto;

        perspective: 1000px;

        /* Allows vertical page scrolling on mobile */
        touch-action: pan-y;
    }


    /* =========================
       CARDS
       ========================= */

    .stack-card {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;

        box-sizing: border-box;

        padding: 40px;

        border-radius: 28px;

        border: 1px solid rgba(48, 54, 79, 0.08);

        color: #30364F;

        user-select: none;

        cursor: grab;

        transform-origin: center bottom;

        transition:
            transform 500ms cubic-bezier(.22, .61, .36, 1),
            opacity 300ms ease;

        will-change: transform;

        display: block;
    }

    .stack-card:active {
        cursor: grabbing;
    }


    /* =========================
       PASTEL COLORS
       ========================= */

    .stack-card:nth-child(1) {
        background: #E1F7EA;
    }

    .stack-card:nth-child(2) {
        background: #EEE9FB;
    }

    .stack-card:nth-child(3) {
        background: #FCEBE3;
    }

    .stack-card:nth-child(4) {
        background: #FFF5D6;
    }


    /* =========================
       CARD CONTENT
       ========================= */

    .card-content {
        width: 100%;
        height: 100%;

        display: flex;
        flex-direction: column;
    }


    /* =========================
       NUMBER
       ========================= */

    .card-number {
        font-family: var(--font-body);

        font-size: 12px;
        font-weight: 400;

        letter-spacing: 0.05em;

        color: #30364F;
    }


    /* =========================
       TEXT AREA
       ========================= */

    .card-text {
        margin-top: auto;
        margin-bottom: auto;
    }


    /* =========================
       QUESTION
       ========================= */

    .card-text h3 {
        max-width: 440px;

        margin: 0 0 28px;

        font-family: var(--font-display);

        font-size: 32px;
        font-weight: 600;

        line-height: 1.15;

        color: #30364F;
    }


    /* =========================
       DIVIDER
       ========================= */

    .card-line {
        width: 100%;
        height: 1px;

        margin-bottom: 25px;

        background: rgba(48, 54, 79, 0.15);
    }


    /* =========================
       ANSWER
       ========================= */

    .card-text p {
        max-width: 440px;

        margin: 0;

        font-family: var(--font-body);

        font-size: 15px;
        font-weight: 300;

        line-height: 1.6;

        color: #30364F;
    }


    /* =========================
       SWIPE HINT
       ========================= */

    .card-hint {
        margin-top: auto;

        font-family: var(--font-body);

        font-size: 10px;
        font-weight: 400;

        letter-spacing: 0.08em;

        color: #30364F;

        opacity: 0.7;
    }


    /* =========================
       MOBILE
       ========================= */

    @media (max-width: 768px) {

        .card-stack {
            width: 100%;
            height: 390px;
        }

        .stack-card {
            padding: 28px;
            border-radius: 22px;
        }

        .card-text h3 {
            font-size: 25px;
            margin-bottom: 22px;
        }

        .card-text p {
            font-size: 14px;
            line-height: 1.55;
        }

    }


    /* =========================
       SMALL MOBILE
       ========================= */

    @media (max-width: 480px) {

        .card-stack {
            height: 360px;
        }

        .stack-card {
            padding: 24px;
            border-radius: 20px;
        }

        .card-text h3 {
            font-size: 23px;
        }

        .card-text p {
            font-size: 13px;
        }

        .card-hint {
            font-size: 9px;
        }

    }


    /* =========================
       REDUCED MOTION
       ========================= */

    @media (prefers-reduced-motion: reduce) {

        .stack-card {
            transition: none;
        }

    }

</style>


<script>

    const stacks = document.querySelectorAll("[data-card-stack]");

    stacks.forEach((stack) => {

        const cards = Array.from(
            stack.querySelectorAll("[data-card]")
        );

        if (cards.length === 0) return;


        let activeCard = cards[cards.length - 1];

        let startX = 0;
        let currentX = 0;

        let dragging = false;


        /* =========================
           POSITION CARDS
           ========================= */

        function positionCards() {

            cards.forEach((card, index) => {

                const position = cards.length - 1 - index;

                (card as HTMLElement).style.zIndex = String(index);

                (card as HTMLElement).style.opacity = "1";

                if (position === 0) {

                    /* Top card */

                    (card as HTMLElement).style.transform =
                        "translate3d(0, 0, 0) scale(1)";

                } else if (position === 1) {

                    /* Middle card */

                    (card as HTMLElement).style.transform =
                        "translate3d(0, 12px, -20px) scale(.96)";

                    (card as HTMLElement).style.opacity = "0.8";

                } else {

                    /* Back card */

                    (card as HTMLElement).style.transform =
                        "translate3d(0, 24px, -40px) scale(.92)";

                    (card as HTMLElement).style.opacity = "0.6";

                }

            });


            activeCard = cards[cards.length - 1];
        }


        /* =========================
           START DRAG
           ========================= */

        function startDrag(event: PointerEvent) {

            if (activeCard !== event.currentTarget) return;

            dragging = true;

            startX = event.clientX;

            currentX = 0;

            activeCard.setPointerCapture(event.pointerId);

            (activeCard as HTMLElement).style.transition = "none";
        }


        /* =========================
           DRAG
           ========================= */

        function drag(event: PointerEvent) {

            if (!dragging) return;

            currentX = event.clientX - startX;

            const rotation = currentX / 20;

            (activeCard as HTMLElement).style.transform =
                `translate3d(${currentX}px, 0, 40px) rotate(${rotation}deg)`;
        }


        /* =========================
           END DRAG
           ========================= */

        function endDrag() {

            if (!dragging) return;

            dragging = false;

            (activeCard as HTMLElement).style.transition =
                "transform 500ms cubic-bezier(.22, .61, .36, 1)";


            const threshold = 120;


            /* =========================
               SWIPE CARD AWAY
               ========================= */

            if (Math.abs(currentX) > threshold) {

                const direction = currentX > 0 ? 1 : -1;


                (activeCard as HTMLElement).style.transform =
                    `translate3d(${direction * 700}px, 0, 0)
                     rotate(${direction * 25}deg)`;


                setTimeout(() => {

                    /*
                     * Move the top card
                     * to the beginning of the stack.
                     */

                    const topCard = cards.pop();

                    if (topCard) {
                        cards.unshift(topCard);
                    }

                    positionCards();

                }, 500);


            } else {

                /* =========================
                   RETURN CARD TO CENTER
                   ========================= */

                (activeCard as HTMLElement).style.transform =
                    "translate3d(0, 0, 0) scale(1)";
            }

        }


        /* =========================
           EVENT LISTENERS
           ========================= */

        cards.forEach((card) => {

            card.addEventListener(
                "pointerdown",
                (event) => startDrag(event as PointerEvent)
            );

            card.addEventListener(
                "pointermove",
                (event) => drag(event as PointerEvent)
            );

            card.addEventListener(
                "pointerup",
                (event) => endDrag()
            );

            card.addEventListener(
                "pointercancel",
                (event) => endDrag()
            );

        });


        /* =========================
           INITIAL POSITION
           ========================= */

        positionCards();

    });

</script>