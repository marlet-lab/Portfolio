---

import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";


---

<Layout title="Projects" pageClass="projects-page">
    <main class="projects-page" >


        <section class="projects-page-header"> 

            <div class="projects-label">
                <a href="/">
                    ← Back to homepage
                </a>
            </div>

            <h2>Selected Work</h2>
    
        </section>

        <section class="all-projects">

            <ProjectCard
            title="Portfolio 2026"
            description="Frontend  · 2024"
            image="/images/project-5.png"
            href="/projects/project-five"
            />

            <ProjectCard
                title="Navigation & Usability Testing"
                description="UX Research · Prototyping · Usability Testing "
                image="/images/project-1.jpg"
                href="/projects/project-one"
            />

            <ProjectCard
                title="PlateLoop"
                description="Web Development · 2025"
                image="/images/project-2.png"
                href="/projects/project-two"
            />

            <ProjectCard
            title="EPL"
            description="Web Development · 2024"
            image="/images/project-4.png"
            href="/projects/project-four"
            />

            <ProjectCard
                title="Hero Imaging"
                description="Interaction Design · 2025"
                image="/images/project-3.png"
                href="/projects/project-three"
            />

          

         


        </section>

    </main>
    <Footer />




</Layout>
